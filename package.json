{
  "name": "maintenance-warning-snackbar",
  "description": "Super simple vanilla JavaScript lib (under 40 lines of code (excluding CSS string)) to display a maintenance warning side bar. The snackbar is shown for X seconds (currently 10 seconds) and then disappears unless it is closed by the user prior to the X seconds being up.",
  "version": "2.0.0",
  "license": "MIT",
  "author": "Raphael Winkelmann",
  "homepage": "https://github.com/IPS-LMU/maintenanceWarningSnackbar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IPS-LMU/maintenanceWarningSnackbar.git"
  },
  "bugs": {
    "url": "https://github.com/IPS-LMU/maintenanceWarningSnackbar/issues"
  },
  "scripts": {
    "build": "nx build maintenance-warning-snackbar-library",
    "build:watch": "nx build maintenance-warning-snackbar-library --watch",
    "start:demo": "http-server -o demo -c-1",
    "start:demo-legacy": "http-server -o demo-legacy -c-1"
  },
  "private": false,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "21.6.9",
    "@nx/eslint-plugin": "21.6.9",
    "@nx/js": "21.6.9",
    "@nx/vite": "21.6.9",
    "@nx/web": "21.6.9",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "18.16.9",
    "@vitest/ui": "^3.0.0",
    "ajv": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "ngx-deploy-npm": "^8.4.0",
    "nx": "21.6.9",
    "prettier": "^2.6.2",
    "tslib": "^2.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "verdaccio": "^6.0.5",
    "vite": "7.3.6",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "^3.0.0"
  },
  "workspaces": [
    "packages/*",
    "maintenance-warning-snackbar"
  ],
  "dependencies": {
    "http-server": "^0.12.3"
  },
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./maintenance-warning-snackbar/src/lib/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  }
}
